# Required for the deployed product photo manager (/admin/products).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: public site URL, including https://, used for canonical links, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=https://your-site-address

# Optional: shared login throttling for multi-instance deployments.
# Use a Vercel KV or Upstash Redis REST endpoint and token.
# KV_REST_API_URL=https://your-kv-endpoint
# KV_REST_API_TOKEN=your-kv-rest-token
# UPSTASH_REDIS_REST_URL=https://your-redis-endpoint
# UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token
